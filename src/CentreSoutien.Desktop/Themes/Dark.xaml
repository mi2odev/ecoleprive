<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette "B · Marine" (dark) from the design prototype. -->
    <Color x:Key="BgColor">#0D1220</Color>
    <Color x:Key="PanelColor">#141B2B</Color>
    <Color x:Key="SunkColor">#1B2335</Color>
    <Color x:Key="LineColor">#263049</Color>
    <Color x:Key="InkColor">#E6EAF2</Color>
    <Color x:Key="MutedColor">#8F99AE</Color>
    <Color x:Key="AccentColor">#AFC3EA</Color>
    <Color x:Key="OnAccentColor">#0D1220</Color>
    <Color x:Key="SideColor">#0A0F1B</Color>
    <Color x:Key="SideInkColor">#E6EAF2</Color>
    <Color x:Key="SideMutedColor">#8390A8</Color>
    <Color x:Key="SideActiveColor">#12FFFFFF</Color>
    <Color x:Key="SideLineColor">#0FFFFFFF</Color>
    <Color x:Key="PlateColor">#F2F4F8</Color>
    <Color x:Key="OkColor">#7BCC98</Color>
    <Color x:Key="WarnColor">#E7B369</Color>
    <Color x:Key="BadColor">#F58C7F</Color>
    <Color x:Key="OkSoftColor">#247BCC98</Color>
    <Color x:Key="WarnSoftColor">#24E7B369</Color>
    <Color x:Key="BadSoftColor">#24F58C7F</Color>
    <Color x:Key="OverlayColor">#99000000</Color>
    <Color x:Key="HoverColor">#182033</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="SunkBrush" Color="{StaticResource SunkColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="SideBrush" Color="{StaticResource SideColor}" />
    <SolidColorBrush x:Key="SideInkBrush" Color="{StaticResource SideInkColor}" />
    <SolidColorBrush x:Key="SideMutedBrush" Color="{StaticResource SideMutedColor}" />
    <SolidColorBrush x:Key="SideActiveBrush" Color="{StaticResource SideActiveColor}" />
    <SolidColorBrush x:Key="SideLineBrush" Color="{StaticResource SideLineColor}" />
    <SolidColorBrush x:Key="PlateBrush" Color="{StaticResource PlateColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkSoftColor}" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}" />
    <SolidColorBrush x:Key="BadSoftBrush" Color="{StaticResource BadSoftColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
</ResourceDictionary>
