<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.AddDocumentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:core="clr-namespace:CentreSoutien.Presentation.Core;assembly=CentreSoutien.Presentation"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:AddDocumentDialogViewModel}">
    <StackPanel>
        <TextBlock FontSize="14" Margin="0,0,0,4">
            <Run Text="Fichier : " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding FileName, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
        </TextBlock>
        <TextBlock FontSize="14" Margin="0,0,0,16">
            <Run Text="Rattaché à : " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding OwnerLabel, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
        </TextBlock>
        <TextBlock Text="Titre" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding DocumentTitle, UpdateSourceTrigger=PropertyChanged}" ui:FocusOnShow.Enabled="True" />
        <TextBlock Text="Catégorie" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
        <ComboBox ItemsSource="{Binding Categories}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
        <TextBlock Text="Le fichier est copié dans le dossier de l'application et inclus dans les sauvegardes." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
