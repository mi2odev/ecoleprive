<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.RestoreBackupDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:RestoreBackupDialogViewModel}">
    <StackPanel>
        <Border Background="{DynamicResource BadSoftBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Attention : opération irréversible" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}" />
                <TextBlock Text="{Binding Warning}" FontSize="13" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <TextBlock Text="Fichier de sauvegarde" Style="{StaticResource FieldLabel}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Choisir…" Command="{Binding PickFileCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="8,0,0,0" />
            <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" Tag="Aucun fichier choisi" />
        </DockPanel>
        <TextBlock Text="Mot de passe du propriétaire au moment de la sauvegarde" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
        <PasswordBox Style="{StaticResource FieldPasswordBox}" ui:PasswordBinding.Password="{Binding Password, Mode=TwoWay}" ui:FocusOnShow.Enabled="True" />
    </StackPanel>
</UserControl>
