<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.ParentEditorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:ParentEditorDialogViewModel}">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,14" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <UniformGrid Columns="2" Margin="0,0,-16,0">
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Nom complet *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" ui:FocusOnShow.Enabled="True" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Lien avec l'élève" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Relations}" Text="{Binding Relation, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Téléphone 2" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone2, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Profession" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Profession, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </UniformGrid>

        <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" Margin="0,0,0,6" />
    </StackPanel>
</UserControl>
