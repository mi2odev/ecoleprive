<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.TeacherEditorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:TeacherEditorDialogViewModel}">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,14" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <ui:Avatar Size="64" ImagePath="{Binding PhotoPath}" Initials="?" />
            <Button Content="Choisir une photo" Command="{Binding PickPhotoCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="16,0,8,0" VerticalAlignment="Center" />
            <Button Content="Retirer" Command="{Binding RemovePhotoCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                    Visibility="{Binding PhotoPath, Converter={StaticResource NotNullToVisible}}" />
        </StackPanel>

        <UniformGrid Columns="2" Margin="0,0,-16,0">
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Prénom *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" ui:FocusOnShow.Enabled="True" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Nom *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Matière" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding SubjectOptions}" SelectedItem="{Binding SelectedSubject}" DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Au centre depuis (année)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding StartYear, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Type de rémunération" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding CompensationTypes}" SelectedItem="{Binding SelectedCompensation}" DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="{Binding ValueLabel}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding CompensationValue, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </UniformGrid>

        <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" Margin="0,0,0,14" />
        <CheckBox Content="Enseignant actif (compté dans les paiements du mois)" IsChecked="{Binding IsActive}" Margin="0,0,0,6" />
    </StackPanel>
</UserControl>
