<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.CancelReceiptDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:CancelReceiptDialogViewModel}">
    <StackPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Le reçu garde son numéro et reste dans la liste, marqué « Annulé ». Il ne compte plus dans les paiements de l'élève ni dans les recettes." />
        <TextBlock Text="Motif de l'annulation *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Tag="ex. Erreur de saisie" ui:FocusOnShow.Enabled="True"
                 ui:Enter.Command="{Binding ConfirmCommand}" />
        <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,8,0,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dlg:QuickAmountOption}">
                    <Button Content="{Binding Label}" Command="{Binding Apply}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,6" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
