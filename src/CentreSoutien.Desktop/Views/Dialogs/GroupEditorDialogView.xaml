<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.GroupEditorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:GroupEditorDialogViewModel}">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,14" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Cours *" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding CourseOptions}" SelectedItem="{Binding SelectedCourse}" DisplayMemberPath="Label" MaxDropDownHeight="320"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Label" ui:FocusOnShow.Enabled="True" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Nom du groupe *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="ex. A" ui:Enter.Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </Grid>
        <UniformGrid Columns="3" Margin="0,0,-16,0">
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Enseignant" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding TeacherOptions}" SelectedItem="{Binding SelectedTeacher}" DisplayMemberPath="Label" MaxDropDownHeight="320" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Salle" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding RoomOptions}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Label" MaxDropDownHeight="320" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Capacité (élèves) *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" Tag="ex. 20" ui:Enter.Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </UniformGrid>

        <!-- Weekly timetable -->
        <DockPanel Margin="0,4,0,8">
            <Button DockPanel.Dock="Right" Content="Ajouter un créneau" Command="{Binding AddSlotCommand}" Style="{StaticResource LinkButton}" FontSize="13"
                    ToolTip="Ajouter un jour et des horaires de cours (les conflits de salle ou d'enseignant sont signalés)" />
            <TextBlock Text="Emploi du temps hebdomadaire" Style="{StaticResource BodyStrong}" />
        </DockPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Border Style="{StaticResource TableHeader}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Jour" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="Début" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="Fin" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="Salle (si différente)" Style="{StaticResource ColumnHeader}" />
                    </Grid>
                </Border>
                <TextBlock Text="Aucun créneau : ajoutez les jours et heures de cours du groupe." Style="{StaticResource EmptyText}" Margin="12,12"
                           Visibility="{Binding HasNoSlot, Converter={StaticResource BoolToVisible}}" />
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dlg:SlotEditor}">
                            <Border Style="{StaticResource TableRow}" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" DisplayMemberPath="Label" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="ex. 09:00" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="2" Text="{Binding End, UpdateSourceTrigger=PropertyChanged, Delay=300}" Tag="ex. 11:00" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding Rooms}" SelectedItem="{Binding Room}" DisplayMemberPath="Label" Margin="0,0,8,0" />
                                    <Button Grid.Column="4" Content="Retirer" Command="{Binding RemoveCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Live conflicts -->
        <Border Background="{DynamicResource BadSoftBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,10" Margin="0,0,0,12"
                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <TextBlock Text="Conflits d'horaire" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BadBrush}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Conflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource ErrorText}" Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <CheckBox Content="Groupe actif (planifié et proposé aux inscriptions)" IsChecked="{Binding IsActive}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource RequiredLegend}" />
    </StackPanel>
</UserControl>
