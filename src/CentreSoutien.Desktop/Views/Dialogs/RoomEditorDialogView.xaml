<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.RoomEditorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:RoomEditorDialogViewModel}">
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Nom de la salle *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ui:FocusOnShow.Enabled="True" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Capacité (places)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Équipement" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Equipment, UpdateSourceTrigger=PropertyChanged}" Tag="Tableau blanc, vidéoprojecteur…" Margin="0,0,0,14" />
        <CheckBox Content="Salle disponible (proposée pour les groupes)" IsChecked="{Binding IsActive}" Margin="0,0,0,6" />
    </StackPanel>
</UserControl>
