<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.CollectPaymentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:core="clr-namespace:CentreSoutien.Presentation.Core;assembly=CentreSoutien.Presentation"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:CollectPaymentDialogViewModel}">
    <StackPanel>
        <StackPanel Visibility="{Binding CanPickStudent, Converter={StaticResource BoolToVisible}}" Margin="0,0,0,16">
            <TextBlock Text="Élève" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" DisplayMemberPath="Label" IsTextSearchEnabled="True" TextSearch.TextPath="Label" MaxDropDownHeight="320" />
        </StackPanel>
        <TextBlock Visibility="{Binding CanPickStudent, Converter={StaticResource BoolToCollapsed}}" FontSize="14" Margin="0,0,0,16">
            <Run Text="Bénéficiaire : " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding StudentName, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
        </TextBlock>
        <UniformGrid Columns="2" Margin="0,0,0,12">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Objet" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Mois concerné" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Label" />
            </StackPanel>
        </UniformGrid>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,16" />
        <TextBlock Text="Montant (DZD)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LargeTextBox}" FontSize="16" ui:FocusOnShow.Enabled="True" />
        <TextBlock Text="Mode de paiement" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
        <ListBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Label" Style="{StaticResource ChipList}" />
        <TextBlock Text="Note (facultatif)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Content="Imprimer le reçu" IsChecked="{Binding PrintReceipt}" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
