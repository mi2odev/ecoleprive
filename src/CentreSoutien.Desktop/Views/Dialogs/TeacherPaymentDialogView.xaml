<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.TeacherPaymentDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:core="clr-namespace:CentreSoutien.Presentation.Core;assembly=CentreSoutien.Presentation"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:TeacherPaymentDialogViewModel}">
    <StackPanel>
        <TextBlock FontSize="14" Margin="0,0,0,16">
            <Run Text="Bénéficiaire : " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding TeacherName, Mode=OneWay}" Foreground="{DynamicResource InkBrush}" />
        </TextBlock>
        <TextBlock Text="Mois concerné" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Label" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,12,0,16" />
        <TextBlock Text="Montant (DZD)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LargeTextBox}" FontSize="16" ui:FocusOnShow.Enabled="True" />
        <TextBlock Text="Mode de paiement" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
        <ListBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Label" Style="{StaticResource ChipList}" />
        <TextBlock Text="Note (facultatif)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
