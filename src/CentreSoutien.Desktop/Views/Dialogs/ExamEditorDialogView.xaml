<UserControl x:Class="CentreSoutien.Desktop.Views.Dialogs.ExamEditorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:dlg="clr-namespace:CentreSoutien.Presentation.ViewModels.Dialogs;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=dlg:ExamEditorDialogViewModel}">
    <UserControl.Resources>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,14" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Groupe *" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Label"
                  IsTextSearchEnabled="True" TextSearch.TextPath="Label" MaxDropDownHeight="320" Margin="0,0,0,14" />

        <TextBlock Text="Intitulé *" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding ExamTitle, UpdateSourceTrigger=PropertyChanged}" Tag="ex. Test 2, Devoir de synthèse" ui:FocusOnShow.Enabled="True" Margin="0,0,0,14" ui:Enter.Command="{Binding ConfirmCommand}" />

        <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
        <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" Style="{StaticResource ChipList}" Margin="0,0,0,10" />

        <UniformGrid Columns="3" Margin="0,0,-16,0">
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding Date}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Noté sur *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Tag="ex. 20" ui:Enter.Command="{Binding ConfirmCommand}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Cell}">
                <TextBlock Text="Coefficient *" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Coefficient, UpdateSourceTrigger=PropertyChanged}" Tag="ex. 1" ui:Enter.Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </UniformGrid>

        <TextBlock Text="Remarques (facultatif)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" Tag="Chapitres concernés, consignes…" />
        <TextBlock Style="{StaticResource RequiredLegend}" />
    </StackPanel>
</UserControl>
