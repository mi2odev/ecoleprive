<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ReportsViewModel}">
    <UserControl.Resources>
        <!-- Label / amount / share line (payment methods, expense categories). -->
        <DataTemplate x:Key="AmountLineTemplate" DataType="{x:Type vm:ReportAmountLine}">
            <Border Style="{StaticResource TableRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Amount}" Style="{StaticResource BodyStrong}" />
                    <TextBlock Grid.Column="2" Text="{Binding Share}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Label" Width="170" Margin="0,0,8,0" />
                <Button Content="Imprimer / PDF" Command="{Binding PrintCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Exporter tout (Excel)" Command="{Binding ExportAllCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding MonthLabel}" Style="{StaticResource Muted}" />
                <TextBlock Text="Rapports" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Synthèse financière -->
        <TextBlock Text="Synthèse financière" Style="{StaticResource H2}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Summary}" Style="{StaticResource KpiStrip}" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding SummaryCosts}" Style="{StaticResource KpiStrip}" Margin="0,0,0,22" />

        <!-- Par cours / modes / catégories -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="Par cours" Style="{StaticResource H2}" />
                    </Border>
                    <Border Style="{StaticResource TableHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Groupe" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Attendu" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Encaissé" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="%" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Aucun cours facturé ce mois." Style="{StaticResource EmptyText}"
                               Visibility="{Binding ByCourse, Converter={StaticResource NullToVisible}}" />
                    <ItemsControl ItemsSource="{Binding ByCourse}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportCourseLine}">
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Course}" Style="{StaticResource BodyStrong}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Expected}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Collected}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Rate}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Text="Par mode de paiement" Style="{StaticResource H2}" />
                        </Border>
                        <TextBlock Text="Aucun encaissement." Style="{StaticResource EmptyText}"
                                   Visibility="{Binding ByMethod, Converter={StaticResource NullToVisible}}" />
                        <ItemsControl ItemsSource="{Binding ByMethod}" ItemTemplate="{StaticResource AmountLineTemplate}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Text="Dépenses par catégorie" Style="{StaticResource H2}" />
                        </Border>
                        <TextBlock Text="Aucune dépense." Style="{StaticResource EmptyText}"
                                   Visibility="{Binding ByCategory, Converter={StaticResource NullToVisible}}" />
                        <ItemsControl ItemsSource="{Binding ByCategory}" ItemTemplate="{StaticResource AmountLineTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Unpaid + teachers -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UnpaidTotal}" Style="{StaticResource Muted}" />
                            <TextBlock Text="Élèves avec un reste à payer" Style="{StaticResource H2}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="Tous les élèves sont à jour." Style="{StaticResource EmptyText}"
                               Visibility="{Binding Unpaid, Converter={StaticResource NullToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Unpaid}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportUnpaidLine}">
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{Binding Name}" Command="{Binding Open}" Style="{StaticResource InkLinkButton}" FontWeight="Medium"
                                                HorizontalAlignment="Left" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Balance}" Style="{StaticResource BodyStrong}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Phone}" Style="{StaticResource Muted}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="Rémunération des enseignants" Style="{StaticResource H2}" />
                    </Border>
                    <Border Style="{StaticResource TableHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enseignant" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Dû" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Versé" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="Reste" Style="{StaticResource ColumnHeader}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Aucun enseignant actif." Style="{StaticResource EmptyText}"
                               Visibility="{Binding Teachers, Converter={StaticResource NullToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Teachers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportTeacherLine}">
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                            <TextBlock Text="{Binding Rule}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Due}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Paid}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Rest}" Style="{StaticResource BodyStrong}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Attendance + grades -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="Présences par groupe" Style="{StaticResource H2}" />
                    </Border>
                    <Border Style="{StaticResource TableHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Groupe" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Séances" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Présents" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="Absents" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="4" Text="Retards" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="5" Text="Taux" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Aucune séance ce mois." Style="{StaticResource EmptyText}"
                               Visibility="{Binding Attendance, Converter={StaticResource NullToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Attendance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportAttendanceLine}">
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Group}" Style="{StaticResource BodyStrong}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Sessions}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Present}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Absent}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Late}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Rate}" Style="{StaticResource BodyStrong}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="Résultats par groupe" Style="{StaticResource H2}" />
                    </Border>
                    <Border Style="{StaticResource TableHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Groupe" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Évaluations" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Moyenne" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="Admis" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="4" Text="En difficulté" Style="{StaticResource ColumnHeader}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Aucune note saisie." Style="{StaticResource EmptyText}"
                               Visibility="{Binding Grades, Converter={StaticResource NullToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Grades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ReportGradeLine}">
                                <Border Style="{StaticResource TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Group}" Style="{StaticResource BodyStrong}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Exams}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Average}" Style="{StaticResource BodyStrong}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Passing}" Style="{StaticResource Body}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Failing}" Style="{StaticResource Body}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
