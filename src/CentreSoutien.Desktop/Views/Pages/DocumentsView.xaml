<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DocumentsViewModel}">
    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <Button DockPanel.Dock="Right" Content="Ajouter un document" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
            <StackPanel>
                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" />
                <TextBlock Text="Documents" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel Margin="0,0,0,18">
            <TextBox DockPanel.Dock="Left" Width="340" VerticalAlignment="Top" Tag="Titre, catégorie ou personne"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Margin="0,0,12,0" />
            <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" Style="{StaticResource ChipList}" VerticalAlignment="Center" />
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Border Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Titre" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="Catégorie" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="Rattaché à" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="Date" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="4" Text="Taille" Style="{StaticResource ColumnHeader}" />
                    </Grid>
                </Border>
                <TextBlock Text="Aucun document. Ajoutez les règlements, contrats ou factures du centre, ou joignez des pièces depuis les fiches des élèves et enseignants."
                           Style="{StaticResource EmptyText}" Visibility="{Binding Rows, Converter={StaticResource NullToVisible}}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DocumentLine}">
                            <Border Style="{StaticResource TableRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Muted}" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Button Content="{Binding Owner}" Command="{Binding OpenOwner}" Style="{StaticResource InkLinkButton}" HorizontalAlignment="Left"
                                                Visibility="{Binding HasOwnerPage, Converter={StaticResource BoolToVisible}}" />
                                        <TextBlock Text="{Binding Owner}" Style="{StaticResource Body}"
                                                   Visibility="{Binding HasOwnerPage, Converter={StaticResource BoolToCollapsed}}" />
                                        <TextBlock Text="{Binding OwnerType}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Date}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Size}" Style="{StaticResource Muted}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Ouvrir" Command="{Binding Open}" Style="{StaticResource LinkButton}" Margin="0,0,12,0" />
                                        <Button Content="Supprimer" Command="{Binding Delete}" Style="{StaticResource DangerLinkButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
