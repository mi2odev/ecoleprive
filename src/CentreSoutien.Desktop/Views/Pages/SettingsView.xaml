<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <!-- One "label | input" line of a settings form. -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="SettingGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,18,0,2" />
        </Style>
        <Style x:Key="SettingNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="ShortBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="140" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <Button DockPanel.Dock="Right" Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
            <StackPanel>
                <TextBlock Text="Centre, facturation, sauvegardes et sécurité" Style="{StaticResource Muted}" />
                <TextBlock Text="Paramètres" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Label"
                     Style="{StaticResource SectionList}" VerticalAlignment="Top" />

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,8,24,20" VerticalAlignment="Top" MaxWidth="820" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />

                    <!-- ===== Centre ===== -->
                    <StackPanel Visibility="{Binding IsCentre, Converter={StaticResource BoolToVisible}}">
                        <Border Style="{StaticResource SettingRow}" Padding="0,16">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="96" Height="64" Background="#FFFFFF" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}" Margin="0,0,16,0">
                                    <Grid>
                                        <Image Source="{Binding LogoPath, Converter={StaticResource PathToImage}}" Width="88" Height="58" Stretch="Uniform"
                                               Visibility="{Binding HasCustomLogo, Converter={StaticResource BoolToVisible}}" />
                                        <Image Source="pack://application:,,,/Assets/logo.png" Width="88" Height="58" Stretch="Uniform"
                                               Visibility="{Binding HasCustomLogo, Converter={StaticResource BoolToCollapsed}}" />
                                    </Grid>
                                </Border>
                                <Button Content="Remplacer le logo" Command="{Binding ReplaceLogoCommand}" Style="{StaticResource SmallSecondaryButton}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Button Content="Logo par défaut" Command="{Binding DefaultLogoCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                        Visibility="{Binding HasCustomLogo, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Nom du centre" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.CenterName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Adresse" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.Address, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Téléphone" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="E-mail" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.Email, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Devise" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.Currency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ShortBox}" />
                                    <TextBlock Text="Code affiché après les montants (DZD — Dinar algérien)." Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Année scolaire" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.AcademicYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ShortBox}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== Tarifs, paiements et remises ===== -->
                    <StackPanel Visibility="{Binding IsTarifs, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Tarifs" Style="{StaticResource SettingGroup}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Frais d'inscription" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.RegistrationFee, StringFormat={}{0:0.##}}" Style="{StaticResource ShortBox}" />
                                    <TextBlock Text="{Binding Form.Currency}" Style="{StaticResource Muted}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Mensualités des cours" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Le prix mensuel se règle sur chaque cours." Style="{StaticResource Body}" Margin="0,0,10,0" />
                                    <Button Content="Ouvrir les cours" Command="{Binding GoCoursesCommand}" Style="{StaticResource LinkButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Règles de paiement et remises" Style="{StaticResource SettingGroup}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Échéance mensuelle" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Le" Style="{StaticResource Body}" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding Form.PaymentDueDay}" Width="60" />
                                    <TextBlock Text="de chaque mois (1 à 28)" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Relance après" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.ReminderAfterDays}" Width="60" />
                                    <TextBlock Text="jours de retard" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Remise fratrie" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.SiblingDiscountPercent, StringFormat={}{0:0.##}}" Width="60" />
                                    <TextBlock Text="%" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Paiement trimestriel" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.QuarterlyDiscountPercent, StringFormat={}{0:0.##}}" Width="60" />
                                    <TextBlock Text="%" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Règles (note)" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,8,16,0" />
                                <TextBox Grid.Column="1" Text="{Binding Form.PaymentRulesNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}"
                                         Tag="Ex. cas social : au cas par cas" />
                            </Grid>
                        </Border>
                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Content="Gérer les remises" Command="{Binding GoDiscountsCommand}" Style="{StaticResource LinkButton}" />
                            <TextBlock Text="Les remises nommées (fratrie, cas social…) se gèrent dans Paiements → Remises et s'appliquent depuis la fiche de l'élève."
                                       Style="{StaticResource SettingNote}" Margin="0,0,12,0" />
                        </DockPanel>
                    </StackPanel>

                    <!-- ===== Rémunération enseignants ===== -->
                    <StackPanel Visibility="{Binding IsRemun, Converter={StaticResource BoolToVisible}}">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Mode par défaut" Style="{StaticResource SettingLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CompensationTypes}" SelectedItem="{Binding SelectedCompensation}" DisplayMemberPath="Label"
                                          Width="280" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Pourcentage par défaut" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.DefaultCompensationPercent, StringFormat={}{0:0.##}}" Width="60" />
                                    <TextBlock Text="% des mensualités encaissées" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Tarif par séance" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.DefaultSessionRate, StringFormat={}{0:0.##}}" Style="{StaticResource ShortBox}" />
                                    <TextBlock Text="{Binding Form.Currency}" Style="{StaticResource Muted}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Forfait mensuel" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.DefaultMonthlySalary, StringFormat={}{0:0.##}}" Style="{StaticResource ShortBox}" />
                                    <TextBlock Text="{Binding Form.Currency}" Style="{StaticResource Muted}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Jour de versement" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Le" Style="{StaticResource Body}" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding Form.TeacherPayDay}" Width="60" />
                                    <TextBlock Text="du mois (30 = dernier jour)" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Chaque enseignant peut avoir sa propre règle depuis sa fiche." Style="{StaticResource SettingNote}" />
                    </StackPanel>

                    <!-- ===== Présences et notes ===== -->
                    <StackPanel Visibility="{Binding IsEval, Converter={StaticResource BoolToVisible}}">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Retard compté après" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.LateAfterMinutes}" Width="60" />
                                    <TextBlock Text="minutes" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Alerte après" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.AbsenceAlertThreshold}" Width="60" />
                                    <TextBlock Text="absences dans le mois" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Barème" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Sur" Style="{StaticResource Body}" Margin="0,0,10,0" />
                                    <TextBox Text="{Binding Form.GradeScale, StringFormat={}{0:0.##}}" Width="60" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Moyenne de réussite" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.PassingGrade, StringFormat={}{0:0.##}}" Width="60" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Arrondi des moyennes" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.GradeDecimals}" Width="60" />
                                    <TextBlock Text="décimales" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Form.NotifyParentOnAbsence}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Prévenir le parent en cas d'absence" FontSize="13" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Text="Après l'enregistrement des présences, les messages d'absence (WhatsApp ou copie) s'ouvrent automatiquement." Style="{StaticResource Small}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <!-- ===== Reçus ===== -->
                    <StackPanel Visibility="{Binding IsRecus, Converter={StaticResource BoolToVisible}}">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Préfixe" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.ReceiptPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ShortBox}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Prochain numéro" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Form.NextReceiptNumber}" Style="{StaticResource ShortBox}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Mention en pied de page" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" Margin="0,8,16,0" />
                                <TextBox Grid.Column="1" Text="{Binding Form.ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" />
                            </Grid>
                        </Border>
                        <CheckBox Content="Afficher le logo sur les reçus" Style="{StaticResource Switch}" IsChecked="{Binding Form.ShowLogoOnReceipt}" Margin="0,14,0,0" />
                    </StackPanel>

                    <!-- ===== Messages aux parents ===== -->
                    <StackPanel Visibility="{Binding IsMessages, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Textes utilisés pour les relances de paiement (Paiements → Relances) et les avis d'absence (Présences). Ils sont envoyés depuis WhatsApp, par SMS ou imprimés : l'application n'envoie rien elle-même."
                                   Style="{StaticResource SettingNote}" Margin="0,14,0,4" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top" Margin="0,8,16,0">
                                    <TextBlock Text="Relance de paiement" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                    <Button Content="Texte par défaut" Command="{Binding ResetPaymentTemplateCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding PaymentTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="96" />
                                    <TextBlock Text="Aperçu" Style="{StaticResource SettingGroup}" Margin="0,10,0,4" />
                                    <Border Background="{DynamicResource SunkBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,10">
                                        <TextBlock Text="{Binding PaymentPreview}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top" Margin="0,8,16,0">
                                    <TextBlock Text="Avis d'absence" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                    <Button Content="Texte par défaut" Command="{Binding ResetAbsenceTemplateCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding AbsenceTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultilineTextBox}" MinHeight="80" />
                                    <TextBlock Text="Aperçu" Style="{StaticResource SettingGroup}" Margin="0,10,0,4" />
                                    <Border Background="{DynamicResource SunkBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,10">
                                        <TextBlock Text="{Binding AbsencePreview}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Champs disponibles" Style="{StaticResource SettingLabel}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding PlaceholderHelp, Mode=OneWay}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Indicatif téléphonique" Style="{StaticResource SettingLabel}" />
                                <DockPanel Grid.Column="1">
                                    <TextBox Text="{Binding Form.PhoneCountryCode, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <TextBlock Text="213 pour l'Algérie : 0661 24 18 90 devient +213 661 24 18 90 pour WhatsApp." Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== Sauvegarde et export ===== -->
                    <StackPanel Visibility="{Binding IsBackup, Converter={StaticResource BoolToVisible}}">
                        <Border Style="{StaticResource SettingRow}" Padding="0,16">
                            <CheckBox Content="Sauvegarde automatique quotidienne" Style="{StaticResource Switch}" IsChecked="{Binding Form.AutoBackupEnabled}" />
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Heure" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding AutoBackupTime, UpdateSourceTrigger=PropertyChanged}" Width="80" Tag="22:00" />
                                    <TextBlock Text="Rattrapée au prochain démarrage si l'ordinateur était éteint." Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Dossier de sauvegarde" Style="{StaticResource SettingLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding DefaultBackupFolder}" />
                                <Button Grid.Column="2" Content="Parcourir…" Command="{Binding BrowseBackupFolderCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Conserver" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Text="{Binding Form.BackupRetentionCount}" Width="60" />
                                    <TextBlock Text="dernières sauvegardes" Style="{StaticResource Body}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Dernière sauvegarde" Style="{StaticResource SettingLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding LastBackupLabel}" Style="{StaticResource Body}" />
                            </Grid>
                        </Border>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Sauvegarder maintenant" Command="{Binding BackupNowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                            <Button Content="Restaurer…" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                            <Button Content="Exporter les données (Excel)" Command="{Binding ExportDataCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                            <Button Content="Charger des données de démonstration" Command="{Binding LoadDemoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                    Visibility="{Binding CanLoadDemo, Converter={StaticResource BoolToVisible}}" />
                        </WrapPanel>
                        <TextBlock Text="Les sauvegardes sont chiffrées et incluent la base, les photos et les documents. Elles se restaurent avec le mot de passe du propriétaire en vigueur au moment de la sauvegarde."
                                   Style="{StaticResource SettingNote}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- ===== Langue et thème ===== -->
                    <StackPanel Visibility="{Binding IsApp, Converter={StaticResource BoolToVisible}}">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Langue" Style="{StaticResource SettingLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox SelectedIndex="0" Width="220">
                                        <ComboBoxItem Content="Français" />
                                        <ComboBoxItem Content="العربية — bientôt disponible" IsEnabled="False" />
                                        <ComboBoxItem Content="English — bientôt disponible" IsEnabled="False" />
                                    </ComboBox>
                                    <TextBlock Text="L'arabe et l'anglais arriveront dans une prochaine version." Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Thème" Style="{StaticResource SettingLabel}" />
                                <ListBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label" Style="{StaticResource ChipList}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== Sécurité ===== -->
                    <StackPanel Visibility="{Binding IsSecurity, Converter={StaticResource BoolToVisible}}">
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Verrouillage après inactivité" Style="{StaticResource SettingLabel}" />
                                <ListBox Grid.Column="1" ItemsSource="{Binding LockDelays}" SelectedItem="{Binding SelectedLockDelay}" DisplayMemberPath="Label" Style="{StaticResource ChipList}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Fin de session après verrouillage" Style="{StaticResource SettingLabel}" />
                                <ListBox Grid.Column="1" ItemsSource="{Binding SessionTimeouts}" SelectedItem="{Binding SelectedSessionTimeout}" DisplayMemberPath="Label" Style="{StaticResource ChipList}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Base de données" Style="{StaticResource SettingLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DatabaseLabel}" Style="{StaticResource Body}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Protection de la clé" Style="{StaticResource SettingLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding KeyProtection}" Style="{StaticResource Body}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Dossier des données" Style="{StaticResource SettingLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding DataFolder}" Style="{StaticResource Body}" ToolTip="{Binding DataFolder}" />
                                <Button Grid.Column="2" Content="Ouvrir le dossier" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource LinkButton}" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Mot de passe de connexion" Style="{StaticResource SettingLabel}" />
                                <Button Grid.Column="1" Content="Modifier dans Mon compte" Command="{Binding GoAccountCommand}" Style="{StaticResource InkLinkButton}" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,16" />
                    <Button Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
