<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.ParentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ParentsViewModel}">
    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Exporter" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Ajouter un parent" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" />
                <TextBlock Text="Parents" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBox Width="340" HorizontalAlignment="Left" Tag="Nom, téléphone ou prénom d'un enfant" Margin="0,0,0,18"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== List ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource TableHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Parent" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="1" Text="Enfants" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="2" Text="Nombre" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Grid.Column="3" Text="{Binding MonthLabel, StringFormat=Reste · {0}}" Style="{StaticResource ColumnHeader}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Aucun parent ne correspond à la recherche." Style="{StaticResource EmptyText}"
                               Visibility="{Binding Rows, Converter={StaticResource NullToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ParentListRow}">
                                <Border x:Name="Sel" Background="Transparent">
                                    <Button Command="{Binding Select}" Style="{StaticResource RowButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                                <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0">
                                                    <Run Text="{Binding Relation, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Phone, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Children}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding ChildCountLabel}" Style="{StaticResource Body}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Balance}" Style="{StaticResource Body}" />
                                        </Grid>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Sel" Property="Background" Value="{DynamicResource SunkBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Selected parent ===== -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource PaddedCard}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToCollapsed}}">
                    <TextBlock Text="Sélectionnez un parent dans la liste." Style="{StaticResource Muted}" />
                </Border>

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                    <Border Style="{StaticResource PaddedCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedName}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding SelectedSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,16" />
                            <ItemsControl ItemsSource="{Binding Info}" Margin="0,0,-20,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding Notes, Converter={StaticResource NotNullToVisible}}" Margin="0,0,0,14">
                                <TextBlock Text="Notes" Style="{StaticResource Small}" />
                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Body}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Modifier" Command="{Binding EditCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="Ajouter un enfant" Command="{Binding AddChildCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="Ajouter un document" Command="{Binding AddDocumentCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="Supprimer" Command="{Binding DeleteCommand}" Style="{StaticResource DangerOutlineButton}" Height="32" FontWeight="Normal" Padding="12,0" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeader}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ajouter un enfant" Command="{Binding AddChildCommand}" Style="{StaticResource LinkButton}" />
                                    <TextBlock Text="{Binding ChildrenTitle}" Style="{StaticResource H2}" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Aucun enfant lié à ce parent." Style="{StaticResource EmptyText}"
                                       Visibility="{Binding Children, Converter={StaticResource NullToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Children}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ParentChildRow}">
                                        <Button Command="{Binding Open}" Style="{StaticResource RowButton}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Avatar Size="30" Initials="{Binding Initials}" />
                                                    <StackPanel Margin="10,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource BodyStrong}">
                                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding Level, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <ContentControl Content="{Binding State}" Focusable="False" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding Balance}" Style="{StaticResource Small}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="20,12">
                                <TextBlock Text="{Binding BalanceLabel}" Style="{StaticResource Muted}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Style="{StaticResource CardHeader}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Ajouter" Command="{Binding AddDocumentCommand}" Style="{StaticResource LinkButton}" />
                                    <TextBlock Text="Documents" Style="{StaticResource H2}" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="Aucun document." Style="{StaticResource EmptyText}"
                                       Visibility="{Binding Documents, Converter={StaticResource NullToVisible}}" />
                            <ItemsControl ItemsSource="{Binding Documents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DocumentRow}">
                                        <Border Style="{StaticResource TableRow}" Padding="20,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                                                    <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0">
                                                        <Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Date, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Ouvrir" Command="{Binding Open}" Style="{StaticResource LinkButton}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="Supprimer" Command="{Binding Delete}" Style="{StaticResource LinkButton}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
