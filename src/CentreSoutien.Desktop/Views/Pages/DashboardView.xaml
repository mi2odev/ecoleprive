<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- Large "Actions rapides" tile: panel card, sunk on hover / keyboard focus. -->
        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius}" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter VerticalAlignment="Top" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SunkBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Title row -->
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Paiements" Command="{Binding GoPaymentsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Encaisser un paiement" Command="{Binding CollectPaymentCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource Muted}" />
                <TextBlock Text="Tableau de bord" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Actions rapides: the most frequent tasks, one click away -->
        <TextBlock Text="Actions rapides" Style="{StaticResource Overline}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding QuickActions}" Margin="0,0,-12,10" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 3 per row: tiles stay readable even at the largest text size. -->
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:QuickAction}">
                    <Button Command="{Binding Command}" Style="{StaticResource QuickActionButton}" Margin="0,0,12,12"
                            ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Label}">
                        <StackPanel>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Premiers pas: guided setup, shown until every required step is done (or hidden by the owner) -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,22"
                Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVisible}}">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OnboardingProgress}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Masquer" Command="{Binding DismissOnboardingCommand}" Style="{StaticResource LinkButton}"
                                    ToolTip="Ne plus afficher cette liste sur cet ordinateur" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Premiers pas" Style="{StaticResource H2}" />
                            <TextBlock Text="Quelques étapes pour mettre le centre en route. Cliquez sur « Faire » pour ouvrir la bonne page."
                                       Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Height="6" CornerRadius="3" Background="{DynamicResource SunkBrush}" ClipToBounds="True" Margin="20,14,20,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding OnboardingDoneShare, Converter={StaticResource ShareToStar}}" />
                            <ColumnDefinition Width="{Binding OnboardingTodoShare, Converter={StaticResource ShareToStar}}" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{DynamicResource OkBrush}" />
                    </Grid>
                </Border>

                <!-- Empty database: try the app with demo data first -->
                <Border Background="{DynamicResource SunkBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="16,12" Margin="20,10,20,4"
                        Visibility="{Binding CanLoadDemo, Converter={StaticResource BoolToVisible}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Paramètres" Command="{Binding GoSettingsCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="Essayer avec des données de démonstration" Command="{Binding LoadDemoCommand}" Style="{StaticResource SmallPrimaryButton}" />
                        </StackPanel>
                        <TextBlock Text="La base est vide. Vous pouvez d'abord découvrir l'application avec des élèves, enseignants et paiements fictifs."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding OnboardingSteps}" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OnboardingStepRow}">
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource OkBrush}"
                                               VerticalAlignment="Center" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}}" />
                                    <TextBlock Text="&#xE739;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisible}}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyStrong}" TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding State, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Faire" Command="{Binding Do}" Style="{StaticResource SmallSecondaryButton}" VerticalAlignment="Center"
                                            Visibility="{Binding IsTodo, Converter={StaticResource BoolToVisible}}" />
                                    <Button Grid.Column="2" Content="Ouvrir" Command="{Binding Do}" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Finance strip -->
        <ItemsControl ItemsSource="{Binding Finance}" Style="{StaticResource KpiStrip}" Margin="0,0,0,22" />

        <!-- À traiter: prioritized alerts -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,22">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AlertCount}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AlertsTitle}" Style="{StaticResource H2}" />
                    </DockPanel>
                </Border>
                <TextBlock Text="Rien à traiter pour le moment." Style="{StaticResource EmptyText}"
                           Visibility="{Binding HasNoAlert, Converter={StaticResource BoolToVisible}}" />
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlertRow}">
                            <Border x:Name="Row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Content="{Binding Badge}" Focusable="False" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="0,2,16,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" Margin="0,3,0,0"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisible}}" />
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0" Focusable="False"
                                                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AlertItemRow}">
                                                    <Button Content="{Binding Text}" Command="{Binding Open}" Style="{StaticResource LinkButton}" Margin="0,2,16,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding More}" Style="{StaticResource Small}" Margin="0,2,0,0"
                                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ActionLabel}" Command="{Binding Action}" Style="{StaticResource LinkButton}"
                                            VerticalAlignment="Top" Margin="0,3,0,0"
                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisible}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Students / Teachers / Courses blocks -->
        <ItemsControl ItemsSource="{Binding Blocks}" Margin="0,0,-16,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DashboardBlock}">
                    <Border Style="{StaticResource PaddedCard}" Margin="0,0,16,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="Ouvrir" Command="{Binding Open}" Style="{StaticResource LinkButton}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Stats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DashboardStat}">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Today's sessions + side column -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Emploi du temps" Command="{Binding GoScheduleCommand}" Style="{StaticResource LinkButton}" />
                            <TextBlock Text="Séances d'aujourd'hui" Style="{StaticResource H2}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="Aucune séance prévue aujourd'hui." Style="{StaticResource EmptyText}"
                               Visibility="{Binding HasNoSessionToday, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Today}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TodayRow}">
                                <Button Command="{Binding Open}" Style="{StaticResource RowButton}" Padding="20,11" ToolTip="Faire l'appel">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyStrong}" Margin="12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Teacher}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Room}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                        <ContentControl Grid.Column="4" Content="{Binding State}" Focusable="False" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <!-- Attendance today -->
                <Border Style="{StaticResource PaddedCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Faire l'appel" Command="{Binding GoAttendanceCommand}" Style="{StaticResource LinkButton}" />
                            <TextBlock Text="Présences du jour" Style="{StaticResource H2}" />
                        </DockPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Attendance[0].Value}" Style="{StaticResource StatValue}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Présents" Style="{StaticResource Small}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Attendance[1].Value}" Style="{StaticResource StatValue}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BadBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Absents" Style="{StaticResource Small}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Attendance[2].Value}" Style="{StaticResource StatValue}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Retards" Style="{StaticResource Small}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource SunkBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding PresentShare, Converter={StaticResource ShareToStar}}" />
                                    <ColumnDefinition Width="{Binding LateShare, Converter={StaticResource ShareToStar}}" />
                                    <ColumnDefinition Width="{Binding AbsentShare, Converter={StaticResource ShareToStar}}" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{DynamicResource OkBrush}" />
                                <Rectangle Grid.Column="1" Fill="{DynamicResource WarnBrush}" />
                                <Rectangle Grid.Column="2" Fill="{DynamicResource BadBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Next session -->
                <Border Style="{StaticResource PaddedCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding NextWhen}" Style="{StaticResource Small}" />
                        <TextBlock Text="{Binding NextName}" FontFamily="{StaticResource SerifFont}" FontSize="21" Margin="0,8,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding NextDetails}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Free rooms -->
                <Border Style="{StaticResource PaddedCard}">
                    <StackPanel>
                        <TextBlock Text="Salles disponibles maintenant" Style="{StaticResource Small}" Margin="0,0,0,12" />
                        <TextBlock Text="Toutes les salles sont occupées." Style="{StaticResource Muted}"
                                   Visibility="{Binding NoFreeRoom, Converter={StaticResource BoolToVisible}}" />
                        <ItemsControl ItemsSource="{Binding FreeRooms}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="28" Padding="10,0" Margin="0,0,6,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Trends: last 6 months / 8 weeks -->
        <TextBlock Text="Tendances" Style="{StaticResource H2}" Margin="0,22,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource PaddedCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Rapports" Command="{Binding GoReportsCommand}" Style="{StaticResource LinkButton}" />
                        <TextBlock Text="Recettes, rémunérations et dépenses" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="{Binding FinanceSummary}" Style="{StaticResource Small}" Margin="0,0,0,14" />
                    <ui:BarChart Data="{Binding FinanceChart}" Height="250" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PaddedCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Paiements" Command="{Binding GoPaymentsCommand}" Style="{StaticResource LinkButton}" />
                        <TextBlock Text="Taux de recouvrement" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="{Binding CollectionSummary}" Style="{StaticResource Small}" Margin="0,0,0,14" />
                    <ui:BarChart Data="{Binding CollectionChart}" ShowLegend="False" Height="250" EmptyText="Aucune séance facturée" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource PaddedCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Présences" Command="{Binding GoAttendanceCommand}" Style="{StaticResource LinkButton}" />
                        <TextBlock Text="Taux de présence par semaine" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="{Binding AttendanceSummary}" Style="{StaticResource Small}" Margin="0,0,0,14" />
                    <ui:LineChart Data="{Binding AttendanceChart}" ShowLegend="False" Height="220" EmptyText="Aucun appel enregistré" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PaddedCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Élèves" Command="{Binding GoStudentsCommand}" Style="{StaticResource LinkButton}" />
                        <TextBlock Text="Élèves par niveau" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="{Binding LevelsSummary}" Style="{StaticResource Small}" Margin="0,0,0,14" />
                    <ui:BarChart Data="{Binding LevelsChart}" Horizontal="True" Height="220" EmptyText="Aucun élève actif" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
