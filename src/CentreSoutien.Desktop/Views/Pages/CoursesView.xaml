<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:CoursesViewModel}">
    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Content="Ajouter un cours" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
            <StackPanel>
                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" />
                <TextBlock Text="Cours" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel Margin="0,0,0,18">
            <TextBox DockPanel.Dock="Left" Width="340" VerticalAlignment="Top" Tag="Matière, niveau ou enseignant"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Margin="0,0,12,0" />
            <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" Style="{StaticResource ChipList}" />
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Border Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cours" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="Groupes" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="Enseignant" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="Horaire" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="4" Text="Inscrits" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="5" Text="Prix / mois" Style="{StaticResource ColumnHeader}" />
                    </Grid>
                </Border>
                <ui:EmptyState Title="Aucun cours pour l'instant" Glyph="&#xE7BE;"
                               Message="Un cours associe une matière, un niveau et un prix mensuel (ex. Mathématiques 3AS). Créez ensuite un ou plusieurs groupes pour chaque cours."
                               Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisible}}">
                    <Button Content="Ajouter un cours" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                </ui:EmptyState>
                <ui:EmptyState Title="Aucun résultat" Glyph="&#xE721;" Padding="20,26"
                               Message="Aucun cours ne correspond à la recherche ou au niveau choisi."
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisible}}">
                    <Button Content="Réinitialiser les filtres" Command="{Binding ClearFiltersCommand}" Style="{StaticResource InkLinkButton}" />
                </ui:EmptyState>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CourseRow}">
                            <Button Command="{Binding Open}" Style="{StaticResource RowButton}" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                        <TextBlock Text="Inactif" Style="{StaticResource Small}" Margin="0,2,0,0"
                                                   Visibility="{Binding IsInactive, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Groups}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Teachers}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Schedule}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Fill}" Style="{StaticResource Body}"
                                               Visibility="{Binding IsFull, Converter={StaticResource BoolToCollapsed}}" />
                                    <ContentControl Grid.Column="4" Content="{Binding FullBadge}" Focusable="False" VerticalAlignment="Center"
                                                    Visibility="{Binding IsFull, Converter={StaticResource BoolToVisible}}" ToolTip="Tous les groupes sont complets" />
                                    <TextBlock Grid.Column="5" Text="{Binding Price}" Style="{StaticResource Body}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
