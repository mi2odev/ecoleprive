<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.TeachersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:TeachersViewModel}">
    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Exporter" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        ToolTip="Enregistrer la liste affichée dans un fichier Excel" />
                <Button Content="Ajouter un enseignant" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" />
                <TextBlock Text="Enseignants" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel Margin="0,0,0,18">
            <TextBox DockPanel.Dock="Left" Width="340" VerticalAlignment="Top" Tag="Nom, matière ou téléphone"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Margin="0,0,12,0" />
            <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Style="{StaticResource ChipList}" VerticalAlignment="Top" Margin="0,3,0,0" />
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Border Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enseignant" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="1" Text="Matière" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="2" Text="Groupes" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="3" Text="Élèves" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="4" Text="Rémunération" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="5" Text="{Binding MonthLabel, StringFormat=Gains · {0}}" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Grid.Column="6" Text="Statut" Style="{StaticResource ColumnHeader}" />
                    </Grid>
                </Border>
                <ui:EmptyState Title="Aucun enseignant pour l'instant" Glyph="&#xE77B;"
                               Message="Enregistrez vos enseignants avec leur matière et leur mode de rémunération (pourcentage, par séance ou fixe) : leurs gains du mois sont ensuite calculés automatiquement."
                               Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisible}}">
                    <Button Content="Ajouter un enseignant" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                </ui:EmptyState>
                <ui:EmptyState Title="Aucun résultat" Glyph="&#xE721;" Padding="20,26"
                               Message="Aucun enseignant ne correspond à la recherche ou au filtre choisi."
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisible}}">
                    <Button Content="Réinitialiser les filtres" Command="{Binding ClearFiltersCommand}" Style="{StaticResource InkLinkButton}" />
                </ui:EmptyState>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TeacherListRow}">
                            <Button Command="{Binding Open}" Style="{StaticResource RowButton}" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Avatar Size="30" Initials="{Binding Initials}" />
                                        <StackPanel Margin="10,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Phone}" Style="{StaticResource Small}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Subject}" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="{Binding Subject}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Groups}" Style="{StaticResource Body}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Students}" Style="{StaticResource Body}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Rule}" Style="{StaticResource Muted}" Margin="0,0,12,0" ToolTip="{Binding Rule}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Earnings}" Style="{StaticResource Body}" Margin="0,0,8,0" />
                                        <ContentControl Content="{Binding PayState}" Focusable="False" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="6" Content="{Binding Status}" Focusable="False" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
