<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AttendanceViewModel}">
    <UserControl.Resources>
        <!-- Clickable wrapper whose look is drawn by the data template. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="← Jour précédent" Command="{Binding PreviousDayCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Aujourd'hui" Command="{Binding TodayCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Jour suivant →" Command="{Binding NextDayCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                <DatePicker SelectedDate="{Binding Day}" Width="160" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding DayLabel}" Style="{StaticResource Muted}" />
                <TextBlock Text="Présences" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sessions of the day -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" ClipToBounds="True">
                <StackPanel>
                    <TextBlock Text="Aucune séance ce jour." Style="{StaticResource EmptyText}"
                               Visibility="{Binding HasNoSession, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding SessionItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttendanceSessionItem}">
                                <Button x:Name="Btn" Command="{Binding Select}" Style="{StaticResource PlainButton}">
                                    <Border x:Name="Bd" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                        <Grid>
                                            <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource InkBrush}" Visibility="Collapsed" />
                                            <StackPanel Margin="16,11">
                                                <DockPanel>
                                                    <TextBlock x:Name="Progress" DockPanel.Dock="Right" Text="{Binding Progress}" Style="{StaticResource Small}" />
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Small}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Progress" Property="Foreground" Value="{DynamicResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SunkBrush}" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding HasSheet, Converter={StaticResource BoolToCollapsed}}">
                <TextBlock Text="Aucune séance prévue ce jour-là. Choisissez une autre date ou créez une séance depuis l'écran Séances."
                           Style="{StaticResource EmptyText}" />
            </Border>

            <!-- Attendance sheet -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Tous présents" Command="{Binding AllPresentCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource SmallPrimaryButton}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding SessionName}" FontFamily="{StaticResource SerifFont}" FontSize="21" Foreground="{DynamicResource InkBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SessionDetails}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <ItemsControl ItemsSource="{Binding Counts}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AttendanceCount}">
                                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,20,0">
                                        <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="Aucun élève inscrit dans ce groupe à cette date." Style="{StaticResource EmptyText}"
                               Visibility="{Binding HasNoStudent, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttendanceStudentRow}">
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,9">
                                    <DockPanel>
                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Choices}" Focusable="False" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AttendanceChoice}">
                                                    <Button x:Name="Btn" Command="{Binding Select}" Style="{StaticResource PlainButton}" Margin="4,0,0,0">
                                                        <Border x:Name="Bd" Height="30" Padding="12,0" CornerRadius="{StaticResource RadiusSmall}" BorderThickness="1"
                                                                BorderBrush="{DynamicResource LineBrush}" Background="Transparent">
                                                            <TextBlock x:Name="T" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedBrush}" />
                                                        </Border>
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                                                        </Trigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOn}" Value="True" />
                                                                <Condition Binding="{Binding Kind}" Value="Ok" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                            <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOn}" Value="True" />
                                                                <Condition Binding="{Binding Kind}" Value="Bad" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BadBrush}" />
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BadSoftBrush}" />
                                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource BadBrush}" />
                                                            <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOn}" Value="True" />
                                                                <Condition Binding="{Binding Kind}" Value="Warn" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                            <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOn}" Value="True" />
                                                                <Condition Binding="{Binding Kind}" Value="Neutral" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SunkBrush}" />
                                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                            <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                            <TextBlock Text="{Binding Matricule}" Style="{StaticResource Small}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
