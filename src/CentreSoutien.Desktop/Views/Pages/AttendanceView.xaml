<UserControl x:Class="CentreSoutien.Desktop.Views.Pages.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:CentreSoutien.Desktop.Controls"
             xmlns:vm="clr-namespace:CentreSoutien.Presentation.ViewModels.Pages;assembly=CentreSoutien.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AttendanceViewModel}">
    <UserControl.Resources>
        <!-- Clickable wrapper whose look is drawn by the data template. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="← Jour précédent" Command="{Binding PreviousDayCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Aujourd'hui" Command="{Binding TodayCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Jour suivant →" Command="{Binding NextDayCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                <DatePicker SelectedDate="{Binding Day}" Width="160" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding DayLabel}" Style="{StaticResource Muted}" />
                <TextBlock Text="Présences" Style="{StaticResource H1}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sessions of the day -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" ClipToBounds="True">
                <StackPanel>
                    <TextBlock Text="Aucune séance ce jour." Style="{StaticResource EmptyText}"
                               Visibility="{Binding HasNoSession, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding SessionItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttendanceSessionItem}">
                                <Button x:Name="Btn" Command="{Binding Select}" Style="{StaticResource PlainButton}">
                                    <Border x:Name="Bd" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                        <Grid>
                                            <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource InkBrush}" Visibility="Collapsed" />
                                            <StackPanel Margin="16,11">
                                                <DockPanel>
                                                    <TextBlock x:Name="Progress" DockPanel.Dock="Right" Text="{Binding Progress}" Style="{StaticResource Small}" />
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Small}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Progress" Property="Foreground" Value="{DynamicResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SunkBrush}" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding HasSheet, Converter={StaticResource BoolToCollapsed}}">
                <ui:EmptyState Title="Aucune séance ce jour-là" Glyph="&#xE787;"
                               Message="L'appel se fait séance par séance. Les séances du jour sont créées d'après l'emploi du temps des groupes : si un groupe a cours ce jour-là, générez ses séances ; sinon choisissez une autre date ou créez une séance exceptionnelle.">
                    <StackPanel Style="{StaticResource EmptyActions}">
                        <Button Content="Générer les séances du jour" Command="{Binding GenerateDayCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                ToolTip="Crée les séances de ce jour à partir de l'emploi du temps" />
                        <Button Content="Emploi du temps" Command="{Binding OpenScheduleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                ToolTip="Voir ou compléter les horaires des groupes" />
                        <Button Content="Séances" Command="{Binding OpenSessionsCommand}" Style="{StaticResource SecondaryButton}"
                                ToolTip="Créer une séance exceptionnelle (rattrapage…)" />
                    </StackPanel>
                </ui:EmptyState>
            </Border>

            <!-- Attendance sheet -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding NotifyParentsLabel}" Command="{Binding NotifyParentsCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,0"
                                        ToolTip="Messages d'absence à envoyer aux parents (WhatsApp ou copie)"
                                        Visibility="{Binding CanNotifyParents, Converter={StaticResource BoolToVisible}}" />
                                <Button Content="Tous présents" Command="{Binding AllPresentCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,8,0"
                                        ToolTip="Marquer tout le groupe présent, puis corriger les absents un par un" />
                                <Button Content="Enregistrer" Command="{Binding SaveCommand}" Style="{StaticResource SmallPrimaryButton}"
                                        ToolTip="Enregistrer les présences de la séance" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding SessionName}" FontFamily="{StaticResource SerifFont}" FontSize="21" Foreground="{DynamicResource InkBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SessionDetails}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource ShortcutLegend}" VerticalAlignment="Center" Margin="16,0,0,0"
                                       ToolTip="Cliquez sur un élève (ou utilisez Tab), puis tapez la lettre : la ligne suivante est sélectionnée automatiquement. Flèches haut / bas pour se déplacer."
                                       Visibility="{Binding HasNoStudent, Converter={StaticResource BoolToCollapsed}}">
                                <Run Text="Raccourcis :" /> <Run Text="P" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><Run Text=" présent · " /><Run Text="A" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><Run Text=" absent · " /><Run Text="R" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><Run Text=" retard · " /><Run Text="E" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" /><Run Text=" excusé" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Counts}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AttendanceCount}">
                                        <TextBlock FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,20,0">
                                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="Aucun élève inscrit dans ce groupe à cette date." Style="{StaticResource EmptyText}"
                               Visibility="{Binding HasNoStudent, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttendanceStudentRow}">
                                <!-- Focusable row: P / A / R / E mark the student and move to the next row (ui:RowKeys). -->
                                <Border x:Name="Row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,9" Background="Transparent"
                                        Focusable="True" FocusVisualStyle="{x:Null}" ui:RowKeys.Command="{Binding MarkKeyCommand}">
                                    <Grid>
                                        <Rectangle x:Name="FocusBar" Width="3" HorizontalAlignment="Left" Margin="-20,-9,0,-9" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                        <DockPanel>
                                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Choices}" Focusable="False" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:AttendanceChoice}">
                                                        <Button x:Name="Btn" Command="{Binding Select}" Style="{StaticResource PlainButton}" Margin="4,0,0,0">
                                                            <Border x:Name="Bd" Height="30" Padding="12,0" CornerRadius="{StaticResource RadiusSmall}" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource LineBrush}" Background="Transparent">
                                                                <TextBlock x:Name="T" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource MutedBrush}" />
                                                            </Border>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="Btn" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                                                            </Trigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                                                    <Condition Binding="{Binding Kind}" Value="Ok" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource OkSoftBrush}" />
                                                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource OkBrush}" />
                                                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                                                    <Condition Binding="{Binding Kind}" Value="Bad" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BadBrush}" />
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BadSoftBrush}" />
                                                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource BadBrush}" />
                                                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                                                    <Condition Binding="{Binding Kind}" Value="Warn" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                                                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsOn}" Value="True" />
                                                                    <Condition Binding="{Binding Kind}" Value="Neutral" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}" />
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SunkBrush}" />
                                                                <Setter TargetName="T" Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                                            </MultiDataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" ToolTip="{Binding Name}" />
                                                <TextBlock Text="{Binding Matricule}" Style="{StaticResource Small}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource SunkBrush}" />
                                        <Setter TargetName="FocusBar" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
